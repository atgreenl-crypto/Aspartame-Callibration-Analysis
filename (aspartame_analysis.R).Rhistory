# 1. Calibration parameters from your 28-point curve
slope     <- 108.5865
intercept <- 0.07836
molar_mass_aspartame <- 294.3  # g/mol
# 2. Input your new experimental data tables
# Table 1: Equal Dilution Series
sweetener_conc_table1 <- c(1.56, 3.12, 6.25, 12.5, 25.0, 50.0) # mg/mL
absorbance_table1    <- c(0.151, 0.270, 0.449, 0.811, 1.304, 1.671)
# Table 2: Replicate Packets at 6.25 mg/mL
replicate_conc <- c(6.25, 6.25, 6.25)
replicate_abs  <- c(0.449, 0.452, 0.432) # Includes Packet 1 from Table 1
# 3. Define function to convert Absorbance to mg Aspartame / g Sweetener
calc_purity <- function(abs_val, sweetener_mg_ml) {
# Molar Concentration (M) = (A - b) / m
conc_M <- (abs_val - intercept) / slope
# mg/mL of pure aspartame in the cuvette
aspartame_mg_ml <- conc_M * molar_mass_aspartame
# mg aspartame per gram of sweetener powder
mg_per_g <- (aspartame_mg_ml / sweetener_mg_ml) * 1000
return(mg_per_g)
}
# 4. Perform calculations
purity_table1 <- calc_purity(absorbance_table1, sweetener_conc_table1)
purity_replicates <- calc_purity(replicate_abs, replicate_conc)
# 5. Compute summary statistics for the 6.25 mg/mL packet replicates
mean_purity <- mean(purity_replicates)
sd_purity   <- sd(purity_replicates)
n_samples   <- length(purity_replicates)
se_purity   <- sd_purity / sqrt(n_samples)
# Calculate 95% Confidence Interval with Student's t-multiplier
t_value      <- qt(0.975, df = n_samples - 1)
margin_error <- t_value * se_purity
ci_lower     <- mean_purity - margin_error
ci_upper     <- mean_purity + margin_error
# 6. Print results to console
cat("=== Purity for Dilution Series (Table 1) ===\n")
for(i in 1:length(sweetener_conc_table1)) {
cat(sprintf("  At %5.2f mg/mL: %6.2f mg/g\n", sweetener_conc_table1[i], purity_table1[i]))
}
cat("\n=== Final Report: Equal Packet Replicates (6.25 mg/mL) ===\n")
cat(sprintf("  Mean Aspartame Content: %.2f mg/g\n", mean_purity))
cat(sprintf("  Standard Deviation:     %.2f mg/g\n", sd_purity))
cat(sprintf("  Standard Error of Mean: %.2f mg/g\n", se_purity))
cat(sprintf("  95%% Confidence Interval: [%.2f, %.2f] mg/g\n", ci_lower, ci_upper))
