plot(df_clean$Concentration, df_clean$Absorbance, type = "p", col = "blue", pch = 16, lwd = 2,
xlim = c(0, 0.010), ylim = c(0, 1.1),
main = "Cleaned Aspartame Calibration Curve (Outliers Removed)",
xlab = "Concentration (M)", ylab = "Absorbance")
# 6. Add the corrected linear regression line
abline(fit_clean, col = "red", lwd = 2)
