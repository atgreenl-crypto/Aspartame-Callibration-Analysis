# ==========================================
# 1. FIXED CALIBRATION CURVE CONSTANTS
# ==========================================
slope <- 88.274       # Molar absorptivity (M^-1 cm^-1)
intercept <- 0.0965   # Regression Intercept
# ==========================================
# 2. ENTER YOUR DATA HERE
# ==========================================
volume_L <- 0.100     # e.g., if you dissolved each packet in 100 mL (0.1 L)
# Brand A Data (Replace these 6 numbers with your actual values)
abs_brandA   <- c(0.45, 0.46, 0.44, 0.47, 0.45, 0.46)
mass_sweetA  <- c(1.01, 0.99, 1.02, 1.00, 0.98, 1.01) # mass of sweetener in grams
reported_valA <- 35.0  # What the brand claims is in it (mg aspartame / g sweetener)
# Brand B Data (Replace these 6 numbers with your actual values)
abs_brandB   <- c(0.55, 0.53, 0.56, 0.54, 0.55, 0.52)
mass_sweetB  <- c(1.00, 1.01, 0.99, 1.02, 1.00, 0.98) # mass of sweetener in grams
reported_valB <- 40.0  # What the brand claims is in it (mg aspartame / g sweetener)
# ==========================================
# 3. AUTOMATED CALCULATION ENGINE
# ==========================================
calc_metrics <- function(abs_vec, mass_vec, brand_name) {
# Step A: Calculate Concentration (M) via Beer-Lambert: C = (A - b) / m
conc_M <- (abs_vec - intercept) / slope
# Step B: Determine mass of aspartame (g) = Molarity * Volume * MW (294.3 g/mol)
mw_aspartame <- 294.3
mass_g_aspartame <- conc_M * volume_L * mw_aspartame
# Step C: Convert to mg aspartame per gram of sweetener
mg_per_g <- (mass_g_aspartame * 1000) / mass_vec
# Step D: Descriptives
mean_val <- mean(mg_per_g)
sd_val   <- sd(mg_per_g)
n        <- length(mg_per_g)
# Step E: 95% Confidence Interval
error <- qt(0.975, df = n - 1) * (sd_val / sqrt(n))
ci_lower <- mean_val - error
ci_upper <- mean_val + error
# Print Outputs
cat(paste0("\n=== ", brand_name, " RESULTS ===\n"))
cat("Concentrations (M): ", round(conc_M, 6), "\n")
cat("Aspartame Mass (g): ", round(mass_g_aspartame, 4), "\n")
cat("Purity (mg/g):      ", round(mg_per_g, 2), "\n")
cat("----------------------------------\n")
cat(paste0("Mean:               ", round(mean_val, 2), " mg/g\n"))
cat(paste0("Std Dev:            ", round(sd_val, 2), " mg/g\n"))
cat(paste0("95% CI:             [", round(ci_lower, 2), ", ", round(ci_upper, 2), "] mg/g\n"))
return(mg_per_g)
}
# Run processing engine
brandA_mg_g <- calc_metrics(abs_brandA, mass_sweetA, "BRAND A")
brandB_mg_g <- calc_metrics(abs_brandB, mass_sweetB, "BRAND B")
# ==========================================
# 4. ONE-SAMPLE T-TESTS vs REPORTED VALUE
# ==========================================
cat("\n=== HYPOTHESIS TESTING (t-test) ===\n")
ttest_A <- t.test(brandA_mg_g, mu = reported_valA)
cat("Brand A vs Reported Claim:\n")
cat("  t-statistic:", round(ttest_A$statistic, 4), "\n")
cat("  p-value:    ", round(ttest_A$p.value, 4), "\n")
ttest_B <- t.test(brandB_mg_g, mu = reported_valB)
cat("\nBrand B vs Reported Claim:\n")
cat("  t-statistic:", round(ttest_B$statistic, 4), "\n")
cat("  p-value:    ", round(ttest_B$p.value, 4), "\n")
