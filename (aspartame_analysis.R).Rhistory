group4 <- c(0.077, 0.133, 0.236, 0.473, 0.675, 0.828, 0.940)
# 3. Combine into a structured data frame for analysis
df <- data.frame(
Concentration = rep(concentration_M, times = 4),
Absorbance    = c(group1, group2, group3, group4),
Group         = rep(c("Group 1", "Group 2", "Group 3", "Group 4"), each = 7)
)
# 4. Fit the global linear regression model across all data points
model <- lm(Absorbance ~ Concentration, data = df)
model_summary <- summary(model)
# 5. Extract analytical and error statistics
slope      <- model_summary$coefficients["Concentration", "Estimate"]
se_slope   <- model_summary$coefficients["Concentration", "Std. Error"]
se_reg     <- model_summary$sigma
r_squared  <- model_summary$r.squared
# Apply Beer-Lambert Law (Path length b = 1.00 cm)
path_length <- 1.00
molar_absorptivity    <- slope / path_length
se_molar_absorptivity <- se_slope / path_length
# 6. Display the final parameters
cat("--- REPLICATE CALIBRATION CURVE RESULTS ---\n")
cat(sprintf("Molar Absorptivity (e):       %.2f M-1 cm-1\n", molar_absorptivity))
cat(sprintf("Standard Error in e:          %.2f M-1 cm-1\n", se_molar_absorptivity))
cat(sprintf("Standard Error of Regression: %.4f\n", se_reg))
cat(sprintf("Coefficient of Determination (R2): %.4f\n", r_squared))
# 7. Generate Plot with color distinctions
# Color mapping: Group 1 is black, Groups 2-4 use distinct colors
